{
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "header", "key": "accept", "value": "text/markdown" }],
      "dest": "/index.md"
    },
    {
      "src": "^/sources\\.html$",
      "has": [{ "type": "header", "key": "accept", "value": "text/markdown" }],
      "dest": "/sources.md"
    },
    { "handle": "filesystem" },
    { "src": "^/about$", "dest": "/about.html" },
    { "src": "^/privacy$", "dest": "/privacy.html" },
    { "src": "^/terms$", "dest": "/terms.html" },
    { "src": "^/contact$", "dest": "/contact.html" },
    { "src": "^/disclosure$", "dest": "/disclosure.html" },
    { "src": "^/sources$", "dest": "/sources.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/sources.html",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google.com https://*.gstatic.com http://imgsct.cookiebot.com https://imgsct.cookiebot.com; font-src 'self'; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com; frame-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}